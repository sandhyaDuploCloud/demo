{
  "manifestVersion": "1.0",
  "id": "duplo.examples.form-wizard",
  "name": "Form Wizard",
  "version": "0.1.0",

  "sdkVersion": "REPLACED_BY_SKILL_FROM_sdk-version_ENDPOINT",
  "backend": {
    "assemblyDir": "duplo.examples.form-wizard/0.1.0/backend",
    "entryAssembly": "Duplo.Extension.HelmDeploy.dll"
  },

  "resources": [
    {
      "ticketOriginType": "HelmDeployment",
      "restSegment": "extensions/helmdeployments",
      "subType": "helm-deployment",
      "archetype": "typed",
      "registrar": "DevOpsResource",
      "entityType": "Duplo.Extension.HelmDeploy.HelmDeploy",
      "specType": "Duplo.Extension.HelmDeploy.HelmDeploySpec",
      "resultType": "Duplo.Extension.HelmDeploy.HelmDeployResult",
      "hooksType": "Duplo.Extension.HelmDeploy.HelmDeployHooks",
      "serviceType": "Duplo.Extension.HelmDeploy.HelmDeployService"
    }
  ],

  "frontend": {
    "remote": {
      "remoteName": "duploExtensionFormWizard",
      "remoteEntry": "/v1/aiservicedesk/extensions/duplo.examples.form-wizard/fe/remoteEntry.json",
      "exposedModule": "./Extension",
      "type": "module"
    },
    "menus": [
      {
        "id": "duplo.examples.form-wizard-devops",
        "title": "DevOps",
        "type": "collapsible-section",
        "children": [
          { "id": "duplo.examples.form-wizard-helm", "title": "Helm Deployments", "type": "item", "matIcon": "package", "relativeUrl": "extensions/helmdeployments", "order": 45 }
        ]
      }
    ],
    "routes": [
      { "path": "extensions/helmdeployments", "resourceType": "HelmDeployment", "subType": "helm-deployment" }
    ]
  }
}
