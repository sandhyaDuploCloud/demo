{
  "manifestVersion": "1.0",
  "id": "duplo.examples.on-demand-plan",
  "name": "On-Demand Plan",
  "version": "0.1.0",

  "sdkVersion": "REPLACED_BY_SKILL_FROM_sdk-version_ENDPOINT",
  "backend": {
    "assemblyDir": "duplo.examples.on-demand-plan/0.1.0/backend",
    "entryAssembly": "Duplo.Extension.Plan.dll"
  },

  "resources": [
    {
      "ticketOriginType": "PlanDemo",
      "restSegment": "extensions/plandemos",
      "subType": "plan-demo",
      "archetype": "typed",
      "registrar": "DevOpsResource",
      "entityType": "Duplo.Extension.PlanDemo.PlanDemo",
      "specType": "Duplo.Extension.PlanDemo.PlanSpec",
      "resultType": "Duplo.Extension.PlanDemo.PlanResult",
      "hooksType": "Duplo.Extension.PlanDemo.PlanHooks",
      "serviceType": "Duplo.Extension.PlanDemo.PlanService"
    }
  ],

  "frontend": {
    "remote": {
      "remoteName": "duploExtensionPlan",
      "remoteEntry": "/v1/aiservicedesk/extensions/duplo.examples.on-demand-plan/fe/remoteEntry.json",
      "exposedModule": "./Extension",
      "type": "module"
    },
    "menus": [
      {
        "id": "duplo.examples.on-demand-plan-devops",
        "title": "DevOps",
        "type": "collapsible-section",
        "children": [
          { "id": "duplo.examples.on-demand-plan-plan", "title": "Plans", "type": "item", "matIcon": "clipboard-text", "relativeUrl": "extensions/plandemos", "order": 44 }
        ]
      }
    ],
    "routes": [
      { "path": "extensions/plandemos", "resourceType": "PlanDemo", "subType": "plan-demo" }
    ]
  }
}
