{
  "manifestVersion": "1.0",
  "id": "duplo.examples.form-complex",
  "name": "Form Complex",
  "version": "0.1.0",

  "sdkVersion": "REPLACED_BY_SKILL_FROM_sdk-version_ENDPOINT",
  "backend": {
    "assemblyDir": "duplo.examples.form-complex/0.1.0/backend",
    "entryAssembly": "Duplo.Extension.AppSvc.dll"
  },

  "resources": [
    {
      "ticketOriginType": "AppServiceLite",
      "restSegment": "extensions/appservicelites",
      "subType": "app-service-lite",
      "archetype": "typed",
      "registrar": "DevOpsResource",
      "entityType": "Duplo.Extension.AppSvc.AppSvcLite",
      "specType": "Duplo.Extension.AppSvc.AppSvcSpec",
      "resultType": "Duplo.Extension.AppSvc.AppSvcResult",
      "hooksType": "Duplo.Extension.AppSvc.AppSvcHooks",
      "serviceType": "Duplo.Extension.AppSvc.AppSvcService"
    }
  ],

  "frontend": {
    "remote": {
      "remoteName": "duploExtensionFormComplex",
      "remoteEntry": "/v1/aiservicedesk/extensions/duplo.examples.form-complex/fe/remoteEntry.json",
      "exposedModule": "./Extension",
      "type": "module"
    },
    "menus": [
      {
        "id": "duplo.examples.form-complex-devops",
        "title": "DevOps",
        "type": "collapsible-section",
        "children": [
          { "id": "duplo.examples.form-complex-appsvc", "title": "App Services (Lite)", "type": "item", "matIcon": "layers", "relativeUrl": "extensions/appservicelites", "order": 46 }
        ]
      }
    ],
    "routes": [
      { "path": "extensions/appservicelites", "resourceType": "AppServiceLite", "subType": "app-service-lite" }
    ]
  }
}
