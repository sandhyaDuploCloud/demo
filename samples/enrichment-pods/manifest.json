{
  "manifestVersion": "1.0",
  "id": "duplo.examples.enrichment-pods",
  "name": "Enrichment Pods (MinIO)",
  "version": "0.1.0",

  "sdkVersion": "REPLACED_BY_SKILL_FROM_sdk-version_ENDPOINT",
  "backend": {
    "assemblyDir": "duplo.examples.enrichment-pods/0.1.0/backend",
    "entryAssembly": "Duplo.Extension.Minio.dll"
  },

  "resources": [
    {
      "ticketOriginType": "MinIO",
      "restSegment": "extensions/minios",
      "subType": "minio",
      "archetype": "typed",
      "registrar": "DevOpsResource",
      "entityType": "Duplo.Extension.Minio.Minio",
      "specType": "Duplo.Extension.Minio.MinioSpec",
      "resultType": "Duplo.Extension.Minio.MinioResult",
      "hooksType": "Duplo.Extension.Minio.MinioHooks",
      "serviceType": "Duplo.Extension.Minio.MinioService"
    }
  ],

  "skills": [
    { "folder": "duplo.examples.enrichment-pods/0.1.0/skills/provision-minio", "isBuiltIn": true }
  ],
  "skillMappings": [
    { "originType": "MinIO", "subType": "minio", "skillNames": ["provision-minio"], "timeout": { "provision": 600, "deprovision": 300 } }
  ],

  "frontend": {
    "remote": {
      "remoteName": "duploExtensionMinio",
      "remoteEntry": "/v1/aiservicedesk/extensions/duplo.examples.enrichment-pods/fe/remoteEntry.json",
      "exposedModule": "./Extension",
      "type": "module"
    },
    "menus": [
      {
        "id": "duplo.examples.enrichment-pods-devops",
        "title": "DevOps",
        "type": "collapsible-section",
        "children": [
          {
            "id": "duplo.examples.enrichment-pods-minio",
            "title": "MinIO",
            "type": "item",
            "matIcon": "database",
            "relativeUrl": "extensions/minios",
            "order": 41
          }
        ]
      }
    ],
    "routes": [
      { "path": "extensions/minios", "resourceType": "MinIO", "subType": "minio" }
    ]
  }
}
